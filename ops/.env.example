# Copy to ops/.env (not committed). install.sh creates it for you.
POSTGRES_PASSWORD=<random string>
API_TOKEN=<random string — the app asks for it on first start>
# Pi: /mnt/hdd/spaternum. Development: ./data (relative to ops/)
DATA_ROOT=/mnt/hdd/spaternum
LOG_LEVEL=INFO
# Port on this machine; change it if 8000 is taken (Portainer uses 8000)
API_PORT=8000
